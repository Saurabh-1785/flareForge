# Continuity Vault Relayer Configuration
# Copy this to .env and fill in your values

# Coston2 RPC endpoint
RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Deployed VaultRegistry contract address (REQUIRED)
REGISTRY_ADDRESS=0xYOUR_DEPLOYED_REGISTRY_ADDRESS

# Relayer private key — hex encoded, no 0x prefix (REQUIRED)
# This key pays for gas on markWarning, requestAttestation, submitQuorumResult, etc.
RELAYER_PRIVATE_KEY=YOUR_RELAYER_PRIVATE_KEY_HEX_NO_0x

# Chain ID (Coston2 = 114, Flare Mainnet = 14)
CHAIN_ID=114

# Vault Enclave URL
ENCLAVE_URL=http://localhost:8090

# Postgres connection string
DATABASE_URL=postgres://localhost:5432/continuity_vault?sslmode=disable

# Demo mode (short intervals for demo)
DEMO_MODE=true
